<%-- The Lato font of all pages from Google Fonts. The links let the browser load the font while it loads the styles,
an @import in main.css would only start after main.css was loaded. --%>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,400;0,700;1,400&display=swap">
