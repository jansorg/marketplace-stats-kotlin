@import dev.ja.marketplace.HtmlAttributes
@import dev.ja.marketplace.data.ChartValues
@import dev.ja.marketplace.data.RenderedDataTable
@import dev.ja.marketplace.data.DataTableSection

@param table: RenderedDataTable
@param section: DataTableSection?
@param renderColumns: Boolean
@param renderHeader: Boolean
@param renderFooter: Boolean
@param title: String? = null

@if(section != null)
    !{val header = section.header}
    !{val title = section.title ?: title}
    !{val columns = section.columns ?: table.columns}

    @if(renderHeader)
        @if(renderColumns)
            @template.tableColumnsRow(table, title = title, columns = columns, cssClass = "row-border-bottom")
        @endif
        @if(header != null)
            @template.dataRowGroup(table = table, group = header, columns = columns, cssClass = "row-border-bottom", renderHeader = true)
        @elseif (!renderColumns && title != null)
            @template.titleRow(columns = columns, title = title, cssClass = "row-border-bottom")
        @endif
    @endif

    <%-- The cells have no whitespace between and in them, large tables would contain more whitespace than values.
         The comments join the lines without adding whitespace to the output. --%>
    @for(row in section.rows)
        !{val chartX = if (table.isChartable) ChartValues.xValue(table.chartPeriod, row.getValue(columns.first())) else null}
        !{val chartCategory = if (columns.any { it.isShareOfTotal || it.rowHistoryPeriod != null }) ChartValues.category(row.getValue(columns.first())) else null}
        <tr class="${row.cssClass}" data-chart-x="${chartX}" data-chart-category="${chartCategory}"><%--
        --%>@for((columnIndex, column) in columns.withIndex())<%--
            --%>!{val chartValue = if (chartX != null && columnIndex > 0 && column.chartMetric == null) ChartValues.value(row.getValue(column)) else null}<%--
            the attributes are only written with a value, see HtmlAttributes
            --%><td $unsafe{HtmlAttributes.of(
                "colspan" to column.columnSpan,
                "class" to column.cssClass,
                "title" to row.getTooltip(column),
                "data-sort" to row.getSortValue(column),
                "data-chart-col" to (if (chartValue != null) columnIndex else null),
                "data-chart-value" to chartValue?.value?.toPlainString(),
                "data-chart-unit" to chartValue?.unit,
                "data-chart-incomplete" to (if (chartValue?.isIncomplete == true) "true" else null),
                "data-chart-share" to (if (chartCategory != null && column.isShareOfTotal) ChartValues.value(row.getValue(column))?.value?.toPlainString() else null),
                "data-chart-history" to (if (column.chartMetric == null) column.rowHistoryPeriod?.let { period -> row.getChartHistory(column)?.let { ChartValues.history(period, it) } } else null),
            )}><%--
                --%>@template.render(row.getValue(column))</td><%--
        --%>@endfor</tr>
    @endfor

    !{val footer = section.footer}
    @if(renderFooter && footer != null)
        @template.dataRowGroup(table = table, group = footer, columns = columns, cssClass = "row-border-light-top row-total", renderHeader = false)
    @endif
@endif
