@import dev.ja.marketplace.ServerConfiguration
@import dev.ja.marketplace.client.model.PluginInfo
@import dev.ja.marketplace.client.model.PluginInfoSummary
@import dev.ja.marketplace.client.model.PluginRating
@import dev.ja.marketplace.client.model.PluginSale
@import dev.ja.marketplace.client.YearMonthDay
@import dev.ja.marketplace.data.RenderedDataTable
@import dev.ja.marketplace.client.LicenseInfo
@import dev.ja.marketplace.client.MarketplaceUrlSupport

@param pageTitle: String?
@param pageDescription: String?
@param today: YearMonthDay
@param plugin: PluginInfo
@param rating: PluginRating
@param tables: List<RenderedDataTable>
@param cssClass: String?
@param urls: MarketplaceUrlSupport
@param settings: ServerConfiguration
@param majorReleases: List<dev.ja.marketplace.data.releases.MajorRelease>
@param ideReleases: List<dev.ja.marketplace.data.releases.MajorRelease>
@param priceChanges: List<dev.ja.marketplace.data.prices.PriceChange>
@param otherPlugins: List<dev.ja.marketplace.client.model.PluginInfoSummary> = emptyList()
@param customEvents: List<dev.ja.marketplace.CustomEvent> = emptyList()

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>${plugin.name}: ${pageTitle ?: "Report"}</title>
    @template.favicons()
    <link rel="stylesheet" type="text/css" href="/styles/main.css"/>
    <link rel="stylesheet" type="text/css" media="print" href="/styles/print.css"/>
    <link href="/js/sortable-base.min.css" rel="stylesheet"/>
    <link href="/js/uPlot.min.css" rel="stylesheet"/>
    <script src="/js/sortable.min.js"></script>
    <script src="/js/uPlot.iife.min.js" defer></script>
    <script type="module" src="/js/charts/main.js"></script>
    <script type="module" src="/js/collapsibleTables.js"></script>
</head>
<body class="${cssClass}" data-locale="${java.util.Locale.getDefault().toLanguageTag()}">
@template.pluginHeader(plugin = plugin, urls = urls, rating = rating, today = today, otherPlugins = otherPlugins)

@template.navbar(plugin = plugin, showResellerCharges = settings.showResellerCharges)

@if(pageTitle != null)
    <h2 class="centered">${pageTitle}</h2>
@endif

@if(pageDescription != null)
    <p class="desc smaller margin-bottom">$unsafe{pageDescription}</p>
@endif

@if(majorReleases.isNotEmpty())
    <ul id="chart-major-releases" hidden>
        @for(release in majorReleases)
            <li data-date="${release.date.asIsoString}">${release.version}</li>
        @endfor
    </ul>
@endif
@if(priceChanges.isNotEmpty())
    <ul id="chart-price-changes" hidden>
        @for(change in priceChanges)
            <li data-date="${change.date.asIsoString}">${change.label}</li>
        @endfor
    </ul>
@endif
@if(ideReleases.isNotEmpty())
    <ul id="chart-ide-releases" hidden>
        @for(release in ideReleases)
            <li data-date="${release.date.asIsoString}">${release.version}</li>
        @endfor
    </ul>
@endif
@template.customEvents(events = customEvents)

<section class="tables">
    @for(table in tables)
        @template.dataTable(plugin, table)
    @endfor
</section>

@template.siteFooter(dropCachesPluginId = plugin.id)
</body>
</html>