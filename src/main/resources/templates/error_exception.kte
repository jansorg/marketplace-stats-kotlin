@param exception: Exception

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Request Error</title>
    @template.favicons()
    @template.fonts()
    <link rel="stylesheet" type="text/css" href="/styles/main.css"/>
    <link rel="stylesheet" type="text/css" media="print" href="/styles/print.css"/>
</head>
<body>
<h1>Error</h1>

<p class="desc margin-bottom">
    An error occurred while preparing the page.
    It could be a bug in marketplace-stats server itself or request to the JetBrains Marketplace.
</p>

<p class="margin-bottom"><a href="/">Back to all plugins</a></p>

<dl>
    <dt>Stacktrace</dt>
    <dd>
        <pre>${exception.stackTraceToString()}</pre>
    </dd>
</dl>

@template.siteFooter()
</body>
</html>