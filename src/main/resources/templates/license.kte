@import dev.ja.marketplace.ServerConfiguration
@import dev.ja.marketplace.data.RenderedDataTable
@import dev.ja.marketplace.client.LicenseInfo
@import dev.ja.marketplace.client.model.PluginInfo
@import dev.ja.marketplace.client.model.PluginTrial
@import dev.ja.marketplace.client.LicenseId
@import dev.ja.marketplace.data.licenses.FallbackVersion

@param cssClass: String?
@param plugin: PluginInfo
@param urls: dev.ja.marketplace.client.MarketplaceUrlSupport
@param rating: dev.ja.marketplace.client.model.PluginRating
@param today: dev.ja.marketplace.client.YearMonthDay
@param otherPlugins: List<dev.ja.marketplace.client.model.PluginInfoSummary>
@param licenseId: LicenseId
@param licenseTable: RenderedDataTable
@param fallbackVersion: FallbackVersion?
@param settings: ServerConfiguration

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>License Details: ${licenseId}</title>
    @template.favicons()
    <link rel="stylesheet" type="text/css" href="/styles/main.css"/>
    <link rel="stylesheet" type="text/css" media="print" href="/styles/print.css"/>
</head>

<body class="${cssClass}">
<%-- the page only exists for this plugin, the menu of the other plugins links to their overview --%>
@template.pluginHeader(plugin = plugin, urls = urls, rating = rating, today = today, otherPlugins = otherPlugins, otherPluginPath = "/")
@template.navbar(plugin = plugin, showResellerCharges = settings.showResellerCharges)

<h2 class="centered">License Details</h2>

<div class="sections">

    <div class="section-wide">
        <dl class="detail-grid">
            <div>
                <dt>ID</dt>
                <dd>${licenseId}</dd>
            </div>

            @if(fallbackVersion != null)
                <div>
                    <dt>Fallback Version</dt>
                    !{val fallbackRelease = fallbackVersion.release}
                    <dd>@template.fallbackVersion(version = fallbackVersion)@if(fallbackRelease != null) (${fallbackRelease.date.toString()})@endif</dd>
                </div>
            @endif
        </dl>
    </div>

    <div class="section-wide">
        <h2>Sales</h2>

        @if (licenseTable.isEmpty)
            <p class="em">No sales available.</p>
        @else
            @template.dataTable(plugin, licenseTable)
        @endif
    </div>
</div>

@template.siteFooter()
</body>
</html>