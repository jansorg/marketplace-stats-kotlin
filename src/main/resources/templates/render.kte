@import gg.jte.support.ForSupport
@import java.math.BigDecimal
@import java.math.BigInteger
@import dev.ja.marketplace.data.ChartMetricName
@import dev.ja.marketplace.data.ExpiredLicenseEnd
@import dev.ja.marketplace.data.IncompleteValue
@import dev.ja.marketplace.data.LinkedChurnRate
@import dev.ja.marketplace.data.LinkedCustomer
@import dev.ja.marketplace.data.LinkedCustomerName
@import dev.ja.marketplace.data.LinkedLicense
@import dev.ja.marketplace.data.LinkedRefNum
@import dev.ja.marketplace.data.PercentageValue
@import dev.ja.marketplace.data.TransferredLicenseEnd
@import dev.ja.marketplace.data.format.Formatters
@import dev.ja.marketplace.data.licenses.FallbackVersion
@import dev.ja.marketplace.data.offers.LinkedOfferUsage
@import javax.money.MonetaryAmount

@param value: Any?
<%-- The values have no whitespace around them: the cells of large tables would contain more whitespace than values.
     The comments join the lines without adding whitespace to the output. --%>@if(value is Array<*>)<%--
    --%>@for(i in ForSupport.of(value))@template.render(i.get())@if(!i.isLast)<br>@endif@endfor<%--
--%>@elseif(value is Iterable<*>)<%--
    --%>@for(i in ForSupport.of(value))@template.render(i.get())@if(!i.isLast)<br>@endif@endfor<%--
--%>@elseif(value is MonetaryAmount)${Formatters.formatAmount(value)}<%--
--%>@elseif(value is PercentageValue)@if(value === PercentageValue.ZERO)—@else${Formatters.formatPercentage(value.value)}@endif<%--
--%>@elseif(value is BigInteger)${Formatters.formatInteger(value)}<%--
--%>@elseif(value is BigDecimal)${Formatters.formatDecimal(value)}<%--
--%>@elseif(value is Double)${Formatters.formatDecimal(value)}<%--
--%>@elseif(value is Float)${Formatters.formatDecimal(value.toDouble())}<%--
--%>@elseif(value is ExpiredLicenseEnd)<span class="expired-marker" title="Expired license, it ended on ${value.expiryDate.toString()}"></span>${value.date.toString()}<%--
--%>@elseif(value is TransferredLicenseEnd)<span class="transferred-marker" title="Transferred license, renewed by ${value.customerName ?: "customer ${value.customer.id}"} until ${value.licenseEnd.toString()}">→ <a href="/customer/${value.customer.id}?pId=${value.customer.pluginId}">${value.customer.id}</a>, </span>${value.date.toString()}<%--
--%>@elseif(value is FallbackVersion)@template.fallbackVersion(version = value)<%--
--%>@elseif(value is IncompleteValue)<span class="incomplete">@template.render(value.value)</span><%--
--%>@elseif(value is LinkedCustomer)<a href="/customer/${value.id}?pId=${value.pluginId}">${value.id}</a><%--
--%>@elseif(value is LinkedCustomerName)<a href="/customer/${value.id}?pId=${value.pluginId}">${value.name}</a><%--
--%>@elseif(value is LinkedLicense)<a href="/license/${value.id}?pId=${value.pluginId}">${value.id}</a><%--
--%>@elseif(value is LinkedRefNum)<a href="/refnum/${value.refNum}?pId=${value.pluginId}">${value.refNum}</a><%--
--%>@elseif(value is LinkedChurnRate)<a href="/churn-rate/${value.periodLinkSegment}/${value.previousPeriodMarkerDate.toString()}/${value.currentPeriodMarkerDate.toString()}?pId=${value.pluginId}">@template.render(value.churnRate)</a><%--
--%>@elseif(value is LinkedOfferUsage)<a href="${value.href}">${Formatters.formatInteger(value.count)}</a><%--
--%>@elseif(value is ChartMetricName)<span class="chart-row-name">${value.name}</span><%--
    the button is shown by the charts, see makeRowChartButtons in pageControls.js
    --%><button type="button" class="chart-row-button noprint" hidden data-chart-row-metric="${value.metric}" data-chart-row-title="${value.title}" data-chart-row-unit="${value.unit}" title="Show ${value.title} in a chart" aria-label="Show ${value.title} in a chart"><%--
    --%><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 13.5h12 M2.5 11l3.5-4 3 2.5 4.5-6"/></svg></button><%--
--%>@else${value?.toString()}@endif