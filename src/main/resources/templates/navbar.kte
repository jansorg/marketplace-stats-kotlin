@import dev.ja.marketplace.client.model.PluginInfo

@param plugin: PluginInfo
@param showResellerCharges: Boolean

<nav class="subtitle menu small navbar">
    <a href="/?pluginId=${plugin.id}">Overview</a>
    @if(plugin.isPaidOrFreemium)
        <details class="navbar-menu">
            <summary>Licenses</summary>
            <div>
                <a href="/licenses?pluginId=${plugin.id}&rows=500">All</a>
                <a href="/licenses/active?pluginId=${plugin.id}&rows=500">Active</a>
                <a href="/licenses/churned?pluginId=${plugin.id}&rows=500">Churned</a>
            </div>
        </details>
        <a href="/customers?pluginId=${plugin.id}&rows=500">Customers</a>
        <a href="/countries?pluginId=${plugin.id}">Countries</a>
        <a href="/trials?pluginId=${plugin.id}&rows=100">Trials</a>
        <a href="/trials/funnel?pluginId=${plugin.id}">Trials (Funnel)</a>
        <a href="/subscriptions?pluginId=${plugin.id}">Subscriptions</a>
        <a href="/offers?pluginId=${plugin.id}">Offers</a>
        <a href="/releases?pluginId=${plugin.id}">Releases</a>
        <a href="/resellers?pluginId=${plugin.id}">Resellers</a>
        <a href="/pricing?pluginId=${plugin.id}">Pricing</a>
        @if(showResellerCharges)
        <a href="/charges?pluginId=${plugin.id}">Charges</a>
        @endif
    @else
        <a href="/releases?pluginId=${plugin.id}">Releases</a>
    @endif
    <script>
        // marks the link of the current page, and the menu, which contains it
        const navbar = document.currentScript.parentElement;
        for (const link of navbar.querySelectorAll("a")) {
            if (new URL(link.href).pathname === location.pathname) {
                link.setAttribute("aria-current", "page");
                link.closest("details")?.classList.add("current");
            }
        }

        // the menus are closed by a click outside of them and by the Escape key
        const menus = navbar.querySelectorAll("details.navbar-menu");
        document.addEventListener("click", event => {
            for (const menu of menus) {
                if (menu.open && !menu.contains(event.target)) {
                    menu.open = false;
                }
            }
        });
        document.addEventListener("keydown", event => {
            for (const menu of menus) {
                if (menu.open && event.key === "Escape") {
                    menu.open = false;
                    menu.querySelector("summary").focus();
                }
            }
        });
    </script>
</nav>
