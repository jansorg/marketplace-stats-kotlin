@import dev.ja.marketplace.client.model.PluginInfoSummary
@import dev.ja.marketplace.client.model.PluginPricingModel
@import dev.ja.marketplace.client.MarketplaceUrlSupport
@import dev.ja.marketplace.data.RenderedDataTable

@param plugins: List<PluginInfoSummary>
@param urls: MarketplaceUrlSupport
@param summaryTables: List<RenderedDataTable>
@param ideReleases: List<dev.ja.marketplace.data.releases.MajorRelease>
@param customEvents: List<dev.ja.marketplace.CustomEvent> = emptyList()

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>All Available Plugins</title>
    <meta name="description" content="The plugins of the account with the sales, licenses and trials of the JetBrains Marketplace">
    @template.favicons()
    @template.fonts()
    <link rel="stylesheet" type="text/css" href="${dev.ja.marketplace.StaticAssets.url("/styles/main.min.css")}"/>
    <link rel="stylesheet" type="text/css" media="print" href="${dev.ja.marketplace.StaticAssets.url("/styles/print.min.css")}"/>
    @if(summaryTables.isNotEmpty())
        <script src="${dev.ja.marketplace.StaticAssets.url("/js/uPlot.iife.min.js")}" defer></script>
        <script type="module" src="${dev.ja.marketplace.StaticAssets.url("/js/charts.min.js")}"></script>
        <script type="module" src="${dev.ja.marketplace.StaticAssets.url("/js/collapsibleTables.min.js")}"></script>
    @endif
</head>
<body data-locale="${java.util.Locale.getDefault().toLanguageTag()}">
<main>

<h1>Available Plugins</h1>
@if(summaryTables.isNotEmpty())
    <p class="keyboard-hint noprint"><button type="button" class="keyboard-hint-button" data-show-charts>Press <kbd>C</kbd> to show the charts</button></p>
@endif
<p>Please choose one of the available plugins.</p>
<br>

<h2>Paid or Freemium Plugins</h2>
@if(summaryTables.isNotEmpty() && ideReleases.isNotEmpty())
    <%-- major releases of IntelliJ IDEA as vertical lines of the charts, like on the report pages --%>
    <ul id="chart-ide-releases" hidden>
        @for(release in ideReleases)
            <li data-date="${release.date.asIsoString}">${release.version}</li>
        @endfor
    </ul>
@endif
@if(summaryTables.isNotEmpty())
    @template.customEvents(events = customEvents)
@endif
<ul class="plugin-cards">
    @for(plugin in plugins.filter { it.isPaidOrFreemium })
        <li>
            !{val iconUrl = plugin.iconUrlPath?.let { urls.assetUrl(it) }}
            <a class="plugin-card" href="/?pluginId=${plugin.id}">
                @if(iconUrl != null)<img src="${iconUrl}" alt="" class="plugin-card-icon"/>@endif
                <span>${plugin.name}</span>
            </a>
        </li>
    @endfor
</ul>
@if(summaryTables.isNotEmpty())
    <p class="summary-description">The sales and downloads of all paid and freemium plugins.</p>
    <section class="tables">
        @for(table in summaryTables)
            @template.dataTable(null, table)
        @endfor
    </section>
@endif

<h2>Free Plugins</h2>
<p>There's only limited data provided for free plugins.</p>
<ul class="plugin-cards">
    @for(plugin in plugins.filter { !it.isPaidOrFreemium })
        <li>
            !{val iconUrl = plugin.iconUrlPath?.let { urls.assetUrl(it) }}
            <a class="plugin-card" href="/?pluginId=${plugin.id}">
                @if(iconUrl != null)<img src="${iconUrl}" alt="" class="plugin-card-icon"/>@endif
                <span>${plugin.name}</span>
            </a>
        </li>
    @endfor
</ul>

</main>

@template.siteFooter()
</body>
</html>