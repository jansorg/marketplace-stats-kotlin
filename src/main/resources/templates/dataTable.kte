@import dev.ja.marketplace.data.RenderedDataTable
@import dev.ja.marketplace.data.DataTableColumn
@import dev.ja.marketplace.data.DataTableSection
@import dev.ja.marketplace.data.DataTableRow
@import dev.ja.marketplace.client.model.PluginInfo

@param plugin: PluginInfo?
@param table: RenderedDataTable

!{val renderTableHeader = table.sections.size == 1}
<%-- the styles of the columns are rules of the table instead of classes of the cells, see CellStyles --%>
!{val styledColumns = dev.ja.marketplace.CellStyles.styledColumns(table)}
!{val cellsKey = "t" + Integer.toHexString(System.identityHashCode(table))}
!{val cellStyles = dev.ja.marketplace.CellStyles.css(cellsKey, table, styledColumns)}
<%-- the rows of large tables are split into tables, which the browser skips while they're off-screen, see TableChunks --%>
!{val chunkRows = dev.ja.marketplace.TableChunks.rowsPerChunk(table, cellStyles != null)}
!{val tableClasses = "small table-striped " + table.cssClass.orEmpty()}
!{val chunkStart = if (chunkRows == null) "" else "<div class=\"table-chunk\"><table class=\"" + dev.ja.marketplace.TableChunks.chunkTableClasses(tableClasses) + "\" data-cells=\"" + cellsKey + "\"><tbody>"}
<div class="table-card">
@if(cellStyles != null)
<style>$unsafe{cellStyles}</style>
@endif
<table class="${tableClasses}" data-cells="${if (cellStyles != null) cellsKey else null}" data-row-chunks="${chunkRows}" data-collapsed-rows="${table.collapsedRowCount}" data-chart-title="${if (table.isChartable || table.columns.any { it.isShareOfTotal || it.rowHistoryPeriod != null }) table.title else null}"
       data-chart-period="${if (table.isChartable) table.chartPeriod.name.lowercase() else null}"
       data-chart-from="${table.chartDateRange?.start?.asIsoString}" data-chart-to="${table.chartDateRange?.end?.asIsoString}">
    @if(renderTableHeader || table.alwaysShowMainColumns)
        <thead>
        @template.tableColumnsRow(table, columns = table.columns, title = table.title, cssClass = "row-border-bottom")
        </thead>
    @endif
    @for(section in table.sections)
        <tbody>
        @template.dataTableSection(
            table = table,
            section = section,
            renderColumns = true,
            renderHeader = !renderTableHeader,
            renderFooter = !renderTableHeader,
            title = section.title ?: table.title,
            styledColumns = styledColumns,
            chunkRows = chunkRows ?: 0,
            chunkStart = chunkStart)
        </tbody>
    @endfor
    @if(renderTableHeader)
        !{val footer = table.sections[0].footer}
        @if(footer != null || table.isLimitedRendering)
            <tfoot>
            @if (footer != null)
                @template.dataRowGroup(table = table, group = footer, columns = table.columns, cssClass = "row-border-light-top", renderHeader = false)
            @endif
            @if(table.isLimitedRendering)
                <tr>
                    <th class="menu centered noprint" colspan="${table.columns.size}">
                        <form action="/refresh?pluginId=${plugin?.id}&rows=" method="POST">
                            <button class="margin-top">Show all rows…</button>
                        </form>
                    </th>
                </tr>
            @endif
            </tfoot>
        @endif
    @endif
</table>
@if(chunkRows != null)
</div>
@endif
</div>