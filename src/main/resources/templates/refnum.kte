@import dev.ja.marketplace.ServerConfiguration
@import dev.ja.marketplace.data.RenderedDataTable
@import dev.ja.marketplace.client.model.PluginInfo
@import dev.ja.marketplace.client.model.PluginSale
@import dev.ja.marketplace.data.LinkedCustomer
@import dev.ja.marketplace.data.lineItems.SaleLineItemSummary

@param cssClass: String?
@param plugin: PluginInfo
@param sale: PluginSale
@param lineItems: List<Pair<SaleLineItemSummary, RenderedDataTable>>
@param settings: ServerConfiguration

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>RefNum Details: ${sale.ref}</title>
    @template.favicons()
    <link rel="stylesheet" type="text/css" href="/styles/main.css"/>
    <link rel="stylesheet" type="text/css" media="print" href="/styles/print.css"/>
</head>

<body class="${cssClass}">
@template.navbar(plugin = plugin, showResellerCharges = settings.showResellerCharges)

<div class="sections">
    <h1>Sale ${sale.ref}</h1>

    <div class="section-wide">
        <dl>
            <dt>RefNum</dt>
            <dd>${sale.ref}</dd>

            <dt>Date</dt>
            <dd>@template.render(value = sale.date)</dd>

            <dt>Customer</dt>
            <dd>@template.render(value = LinkedCustomer(sale.customer.code, plugin.id)) @if (!sale.customer.name.isNullOrEmpty()) (${sale.customer.name})@endif</dd>

            <dt>Customer Type</dt>
            <dd>${sale.customer.type.name}</dd>

            <dt>Customer Country</dt>
            <dd>${sale.customer.country}</dd>

            @if (sale.amount.currency != sale.amountUSD.currency)
                <dt>Amount</dt>
                <dd>@template.render(value = sale.amount)</dd>
            @endif

            <dt>Amount USD</dt>
            <dd>@template.render(value = sale.amountUSD)</dd>

            <dt>License Type</dt>
            <dd>${sale.licensePeriod}</dd>

            !{val reseller = sale.reseller}
            <dt>Reseller</dt>
            @if (reseller == null)
                <dd>—</dd>
            @else
                <dd>${reseller.name} (${reseller.type.displayString}, ${reseller.country}, ID: ${reseller.code})</dd>
            @endif
        </dl>
    </div>

    @if (lineItems.isEmpty())
        <div class="section-wide">
            <h2>Line Items</h2>
            <p class="em">No sale line items available.</p>
        </div>
    @endif

    @for((index, lineItem) in lineItems.withIndex())
        !{val (item, licenseTable) = lineItem}
        !{val subscription = item.subscriptionDates}
        <div class="section-wide">
            <h2>@if(lineItems.size > 1)Line Item ${index + 1}: @endif${item.typeLabel}</h2>
            <dl>
                <dt>Licenses</dt>
                <dd>${item.licenseCount}</dd>

                <dt>Subscription</dt>
                <dd>@if(subscription == null)Perpetual@else${subscription.start.toString()} — ${subscription.end.toString()}@endif</dd>

                <dt>Amount</dt>
                <dd>@template.render(value = item.amount)@if(!item.isUSD) (@template.render(value = item.amountUSD))@endif</dd>

                <dt>Paid Amount</dt>
                <dd title="Amount after the share of the Marketplace">@template.render(value = item.paidAmount)@if(!item.isUSD) (@template.render(value = item.paidAmountUSD))@endif</dd>

                <dt>Discount</dt>
                <dd>@if(item.discounts.isEmpty())—@else@for(discount in item.discounts)<div>${discount}</div>@endfor@endif</dd>
            </dl>

            @template.dataTable(plugin, licenseTable)
        </div>
    @endfor
</div>

@template.siteFooter()
</body>
</html>